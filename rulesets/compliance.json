            "eq": "missing",
            "level": "HIGH"
          }
        ],
        "default": "MEDIUM"
      },
      "min_saving_usd": 0,
      "recommendation": "Set the minimum password length to {min_password_length} in IAM account settings (or create a password policy if none exists).",
      "recommended_action": null,
      "remediation": null,
      "controls": [
        "CIS-AWS-v2.0:1.8"
      ],
      "agents": [
        "compliance-agent"
      ],
      "resource_type": "AWS::IAM::AccountPasswordPolicy",
      "checker": "cis_checker._check_iam_password_policy"
    },
