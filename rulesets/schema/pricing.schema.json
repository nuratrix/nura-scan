{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pricing.schema.json",
  "title": "Price list used to estimate savings",
  "type": "object",
  "required": ["schema_version", "region", "as_of", "currency", "hours_per_month", "prices"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "region": { "type": "string", "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$" },
    "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "currency": { "const": "USD" },
    "hours_per_month": { "type": "number", "exclusiveMinimum": 0 },
    "notes": { "type": "string" },
    "prices": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "number", "minimum": 0 },
          { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
        ]
      }
    },
    "rds_downsize_map": {
      "description": "Next-smaller instance class; savings = price[current] - price[target].",
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
